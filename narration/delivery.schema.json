{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dyslexics/herrober/blob/main/narration/delivery.schema.json",
  "title": "Herr Ober! narration delivery v1",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_sha256",
    "producer",
    "recordings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "voice",
        "usage_rights"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "usage_rights": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recordings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "job_id",
          "job_sha256",
          "audio",
          "words"
        ],
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "job_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "voice": {
            "type": "string",
            "minLength": 1
          },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "token_id",
                "start_ms",
                "end_ms"
              ],
              "additionalProperties": false,
              "properties": {
                "token_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
